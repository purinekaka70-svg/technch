{
  "version": 2,
  "crons": [
    {
      "path": "/api/cron/expire-sessions",
      "schedule": "0 0 * * *"
    }
  ],
  "builds": [
    { "src": "api/[...path].js", "use": "@vercel/node", "config": { "maxDuration": 30 } },
    { "src": "api/cloudpay/webhook.js", "use": "@vercel/node" },
    { "src": "**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/cloudpay/webhook", "dest": "/api/cloudpay/webhook.js" },
    { "src": "/api/(.*)", "dest": "/api/[...path].js?path=/api/$1" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
