{
    "crons":  [
                  {
                      "path":  "/api/cron/expire-sessions",
                      "schedule":  "0 0 * * *"
                  }
              ],
    "builds":  [
                   {
                       "src":  "api/index.js",
                       "use":  "@vercel/node"
                   },
                   {
                       "src":  "**",
                       "use":  "@vercel/static"
                   }
               ],
    "routes":  [
                   {
                       "src":  "/api/(.*)",
                       "dest":  "/api/index"
                   },
                   {
                       "src":  "/(.*)",
                       "dest":  "/$1"
                   }
               ],
    "version":  2
}
