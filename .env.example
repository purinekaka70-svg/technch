# Firebase Admin credentials. Firebase web configuration is embedded in admin.html.
FIREBASE_PROJECT_ID=technch--hotspot
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@technch--hotspot.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Local test environment only. Use matching CloudPay sandbox credentials here.
# In live Vercel settings use production credentials and set CLOUDPAY_ENV=production.
CLOUDPAY_CONSUMER_KEY=your-cloudpay-sandbox-consumer-key
CLOUDPAY_CONSUMER_SECRET=your-cloudpay-sandbox-consumer-secret
CLOUDPAY_WEBHOOK_SECRET=your-cloudpay-sandbox-webhook-secret
CLOUDPAY_ENV=sandbox

# MikroTik HotSpot gateway and local Windows agent.
WIFI_GATEWAY_MODE=mikrotik-agent
MIKROTIK_GATEWAY_ID=main
MIKROTIK_AGENT_TOKEN=generate-a-random-agent-token
MIKROTIK_CREDENTIAL_SECRET=generate-a-separate-random-secret
MIKROTIK_HOTSPOT_LOGIN_URL=http://192.168.88.1/login

# Vercel scheduled session-expiry job.
CRON_SECRET=generate-a-separate-long-random-secret
